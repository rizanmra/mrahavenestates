# Copy to `.env.local` when the client's Firebase + Vercel projects are ready.
# Never commit real keys to git.

# --- Firebase (Client portal auth + Firestore) ---
# Firebase Console → Project settings → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: Analytics
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Server-only API key (recommended). Same project, Application restrictions = None.
# Needed for admin inbox / session verify — Website-restricted keys fail on the server.
# FIREBASE_API_KEY=

# --- Firebase Admin (server: purge removed listings from all shortlists) ---
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# --- Contact form inbox (Contact Us only) ---
# CONTACT_INBOX_EMAIL=info@mrahavenestates.co.uk
#
# Reliable delivery (recommended): Gmail App Password SMTP
# 1) Google Account → Security → 2-Step Verification → App passwords
# 2) Create a Mail app password and paste it below
# CONTACT_SMTP_HOST=smtp.gmail.com
# CONTACT_SMTP_PORT=465
# CONTACT_SMTP_USER=animesdownload1028@gmail.com
# CONTACT_SMTP_PASS=your-16-char-app-password

# --- Staff (optional but recommended on Vercel) ---
# Staff sign-in uses Firebase Auth. Also set ADMIN_PASSWORD on Vercel to the
# same Firebase password so server-side inbox reads work as a fallback.
# ADMIN_EMAIL=mrahavenestates@gmail.com
# ADMIN_PASSWORD=
# ADMIN_NAME=Rizwan
# ADMIN_PHONE=07876827615

# --- Site ---
# NEXT_PUBLIC_SITE_URL=https://www.mrahavenestates.co.uk
