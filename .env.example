# Copy to `.env.local` when the client's Firebase + Vercel projects are ready.
# Never commit real keys to git.

# --- Firebase (Client portal auth + Firestore) ---
# Firebase Console → Project settings → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: Analytics
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- Firebase Admin (server: purge removed listings from all shortlists) ---
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# --- Contact form inbox (Contact Us only) ---
# CONTACT_INBOX_EMAIL=info@mrahavenestates.co.uk
#
# Reliable delivery (recommended): Gmail App Password SMTP
# 1) Google Account → Security → 2-Step Verification → App passwords
# 2) Create a Mail app password and paste it below
# CONTACT_SMTP_HOST=smtp.gmail.com
# CONTACT_SMTP_PORT=465
# CONTACT_SMTP_USER=animesdownload1028@gmail.com
# CONTACT_SMTP_PASS=your-16-char-app-password

# --- Staff (optional) ---
# Staff sign-in uses Firebase Auth (email/password). No paid add-ons required.
# ADMIN_PASSWORD is only used as a server-side fallback to read/write Firestore
# when the browser has not sent a staff Bearer token. Prefer logging in at /login.
# Create the staff user in Firebase Console → Authentication → Users:
#   email: mrahavenestates@gmail.com
# ADMIN_PASSWORD=
# ADMIN_NAME=Rizwan
# ADMIN_PHONE=07876827615

# --- Site ---
# NEXT_PUBLIC_SITE_URL=https://www.mrahavenestates.co.uk
